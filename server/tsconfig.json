{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "src/routes/admin.routes.ts",
    "src/routes/public.routes.ts",
    "src/lib/prisma.ts",
    "src/lib/jwt.ts",
    "src/lib/auth-utils.ts",
    "src/lib/mailer.ts",
    "src/middleware",
    "src/services"
  ]
}
