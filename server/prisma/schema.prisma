generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  PILOT
}

enum CalendarDayStatus {
  OPEN
  BLOCKED
  HOLIDAY
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PROGRESS
  DONE
  WAITING
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  OFFLINE
  ONLINE
}

enum CertificateStatus {
  ACTIVE
  USED
  PARTIAL
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum PromoType {
  BIRTHDAY
  HAPPY_HOURS
  CUSTOM
}

enum AuthCodeType {
  LOGIN_2FA
  DEVICE_CHANGE
  BOOKING_CONFIRM
}

model User {
  id              String           @id @default(uuid())
  login           String           @unique
  passwordHash    String
  role            UserRole
  fullName        String
  phone           String?
  email           String?
  isActive        Boolean          @default(true)
  color           String?
  pilotSimulators String[]         @default([])
  trustedDevices  TrustedDevice[]
  authCodes       AuthCode[]
  staffShifts     StaffShift[]
  calendarDays    CalendarDay[]    @relation("CalendarDaySetBy")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model TrustedDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint String
  userAgent String?
  lastUsedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@unique([userId, fingerprint])
}

model AuthCode {
  id        String       @id @default(uuid())
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingId String?
  booking   Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  email     String?
  code      String
  type      AuthCodeType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
}

model CalendarDay {
  id        String            @id @default(uuid())
  date      DateTime          @db.Date
  status    CalendarDayStatus @default(OPEN)
  setById   String?
  setBy     User?             @relation("CalendarDaySetBy", fields: [setById], references: [id])
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([date])
}

model Booking {
  id               String         @id @default(uuid())
  date             DateTime       @db.Date
  startTime        String
  endTime          String
  durationMin      Int
  simulatorSlug    String
  name             String
  phone            String
  email            String
  status           BookingStatus  @default(PENDING_CONFIRMATION)
  paid             Boolean        @default(false)
  paymentMethod    PaymentMethod  @default(OFFLINE)
  comment          String         @default("")
  isBirthdayPromo  Boolean        @default(false)
  birthdayDate     DateTime?      @db.Date
  certificateNumber String?
  promoNote        String?
  holdExpiresAt    DateTime?
  confirmExpiresAt DateTime?
  authCodes        AuthCode[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([date])
  @@index([simulatorSlug])
  @@index([status])
}

model StaffShift {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulatorSlug String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}

model Certificate {
  id            String            @id @default(uuid())
  number        String            @unique
  phone         String
  fullName      String
  durationMin   Int
  paymentStatus PaymentStatus     @default(UNPAID)
  validFrom     DateTime          @db.Date
  validTo       DateTime          @db.Date
  simulatorSlug String
  status        CertificateStatus @default(ACTIVE)
  comment       String            @default("")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model WaitingRoomEntry {
  id        String   @id @default(uuid())
  date      DateTime @db.Date
  line      String
  createdAt DateTime @default(now())
}

model FlightPrice {
  id            String   @id @default(uuid())
  durationMin   Int
  simulatorSlug String
  priceByn      Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([durationMin, simulatorSlug])
}

model CertificatePrice {
  id            String   @id @default(uuid())
  durationMin   Int
  simulatorSlug String
  priceByn      Int
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([durationMin, simulatorSlug])
}

model Promo {
  id              String    @id @default(uuid())
  name            String
  discountPercent Int
  startDate       DateTime  @db.Date
  endDate         DateTime  @db.Date
  productType     String
  promoType       PromoType @default(CUSTOM)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SettingDocument {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model SettingContact {
  id        String   @id @default(uuid())
  phone     String
  email     String
  hours     String
  updatedAt DateTime @updatedAt
}

model GalleryPhoto {
  id          String   @id @default(uuid())
  serviceSlug String
  url         String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model OptionListItem {
  id        String   @id @default(uuid())
  category  String
  value     String
  label     String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  @@unique([category, value])
}

model MaintenancePlan {
  id        String   @id @default(uuid())
  plannedAt DateTime
  notes     String   @default("")
  createdAt DateTime @default(now())
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model EmailLog {
  id        String   @id @default(uuid())
  to        String
  subject   String
  body      String
  createdAt DateTime @default(now())
}
